        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/k_q" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Q" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_w" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="W" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_e" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="E" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_r" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="R" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_t" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="T" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_y" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Y" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_u" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="U" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_i" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="I" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_o" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="O" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_p" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="P" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
    </LinearLayout>

    <!-- A 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/k_a" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="A" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_s" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="S" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_d" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="D" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_f" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_g" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="G" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_h" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="H" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_j" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="J" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_k" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="K" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_l" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="L" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_escape" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Esc" android:textColor="#a0c0ff" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="12sp"/>
    </LinearLayout>

    <!-- Z 行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/k_z" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Z" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_x" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="X" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_c" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="C" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_v" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="V" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_b" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="B" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_n" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="N" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_m" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="M" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_comma" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="," android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_dot" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="." android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_tab" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Tab" android:textColor="#a0c0ff" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="12sp"/>

        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/k_1" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_2" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_3" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_4" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_5" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_6" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_7" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_8" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_9" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_0" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="0" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>

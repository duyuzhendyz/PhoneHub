<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e1e1e"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 修饰键状态 -->
    <TextView
        android:id="@+id/modifierStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:background="#252525"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="修饰键: 无"
        android:textColor="#b0b0b0"
        android:textSize="12sp" />

    <!-- F1-F6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <Button android:id="@+id/k_f1" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F1" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f2" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F2" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f3" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F3" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f4" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F4" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f5" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F5" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f6" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F6" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
    </LinearLayout>

    <!-- F7-F12 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/k_f7" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F7" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f8" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F8" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f9" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F9" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f10" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F10" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f11" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F11" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_f12" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F12" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
    </LinearLayout>

    <!-- 数字行 -->

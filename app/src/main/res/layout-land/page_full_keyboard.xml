    <!-- 修饰键 + 空格 + 回车 + 退格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <Button android:id="@+id/k_shift" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:text="Shift" android:textColor="#a0a0a0" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <Button android:id="@+id/k_ctrl" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:text="Ctrl" android:textColor="#a0a0a0" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <Button android:id="@+id/k_alt" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:text="Alt" android:textColor="#a0a0a0" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <Button android:id="@+id/k_win" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:text="Win" android:textColor="#a0a0a0" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <Button android:id="@+id/k_space" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3.0" android:text="Space" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="12sp"/>
        <Button android:id="@+id/k_enter" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:text="Enter" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <Button android:id="@+id/k_bksp" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:text="⌫" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>

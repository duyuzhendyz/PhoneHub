    <!-- 方向键（横向排列，适合横屏） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.85"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="end|center_vertical">
        <Button android:id="@+id/k_home" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Home" android:textColor="#a0c0ff" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <Button android:id="@+id/k_end" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="End" android:textColor="#a0c0ff" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <Button android:id="@+id/k_pgup" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="PgUp" android:textColor="#a0c0ff" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <Button android:id="@+id/k_pgdn" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="PgDn" android:textColor="#a0c0ff" android:background="@drawable/kb_modifier_bg" android:layout_margin="2dp" android:textSize="11sp"/>
        <View android:layout_width="12dp" android:layout_height="match_parent" />
        <Button android:id="@+id/k_left" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:text="◀" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_up" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:text="▲" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_down" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:text="▼" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
        <Button android:id="@+id/k_right" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:text="▶" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="2dp" android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>

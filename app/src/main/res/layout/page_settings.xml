<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e1e1e"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2d2d2d"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAW 云端中转"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAW 服务器地址"
                android:textColor="#b0b0b0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPawUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://yourname.pythonanywhere.com"
                android:textColor="#ffffff"
                android:textColorHint="#808080"
                android:background="#3a3a3a"
                android:padding="10dp"
                android:textSize="13sp"
                android:inputType="textUri"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接令牌 (Token)"
                android:textColor="#b0b0b0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPawToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="phonehub_default_secret_token"
                android:textColor="#ffffff"
                android:textColorHint="#808080"
                android:background="#3a3a3a"
                android:padding="10dp"
                android:textSize="13sp"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnSavePaw"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="保存 PAW 设置" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2d2d2d"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接信息"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/infoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态: 未连接"
                android:textColor="#d13438"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/infoIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: 未知"
                android:textColor="#b0b0b0"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/infoChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通道: 无"
                android:textColor="#b0b0b0"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/disconnectBtn2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="断开连接" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e1e1e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- 修饰键状态 -->
        <TextView
            android:id="@+id/modifierStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#252525"
            android:padding="10dp"
            android:text="修饰键: 无"
            android:textColor="#808080"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <!-- F1-F6 行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/k_f1" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F1" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f2" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F2" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f3" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F3" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f4" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F4" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f5" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F5" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f6" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F6" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
        </LinearLayout>

        <!-- F7-F12 行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/k_f7" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F7" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f8" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F8" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f9" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F9" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f10" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F10" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f11" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F11" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_f12" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F12" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
        </LinearLayout>

        <!-- 数字行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/k_1" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="1" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_2" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="2" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_3" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="3" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_4" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="4" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_5" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="5" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_6" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="6" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_7" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="7" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_8" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="8" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_9" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="9" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_0" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="0" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
        </LinearLayout>

        <!-- Q 行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/k_q" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Q" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_w" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="W" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_e" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="E" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_r" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="R" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_t" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="T" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_y" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Y" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_u" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="U" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_i" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="I" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_o" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="O" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_p" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="P" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
        </LinearLayout>

        <!-- A 行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <Button android:id="@+id/k_a" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="A" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_s" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="S" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_d" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="D" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_f" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="F" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_g" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="G" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_h" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="H" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_j" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="J" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_k" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="K" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_l" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="L" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
        </LinearLayout>

        <!-- Z 行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">
            <Button android:id="@+id/k_z" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Z" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_x" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="X" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_c" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="C" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_v" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="V" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_b" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="B" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_n" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="N" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_m" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="M" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_comma" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="," android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_dot" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="." android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
        </LinearLayout>

        <!-- 修饰键行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <Button android:id="@+id/k_shift" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1.3" android:text="Shift" android:textColor="#a0a0a0" android:background="@drawable/kb_modifier_bg" android:layout_margin="1.5dp" android:textSize="12sp"/>
            <Button android:id="@+id/k_ctrl" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1.3" android:text="Ctrl" android:textColor="#a0a0a0" android:background="@drawable/kb_modifier_bg" android:layout_margin="1.5dp" android:textSize="12sp"/>
            <Button android:id="@+id/k_alt" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1.3" android:text="Alt" android:textColor="#a0a0a0" android:background="@drawable/kb_modifier_bg" android:layout_margin="1.5dp" android:textSize="12sp"/>
            <Button android:id="@+id/k_win" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1.3" android:text="Win" android:textColor="#a0a0a0" android:background="@drawable/kb_modifier_bg" android:layout_margin="1.5dp" android:textSize="12sp"/>
            <Button android:id="@+id/k_space" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="3" android:text="Space" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="13sp"/>
            <Button android:id="@+id/k_enter" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1.3" android:text="Enter" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="12sp"/>
            <Button android:id="@+id/k_bksp" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1.3" android:text="⌫" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击修饰键可锁定组合"
            android:textColor="#505050"
            android:textSize="11sp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center" />

        <!-- 方向键行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center">
            <Button android:id="@+id/k_up" style="?android:attr/borderlessButtonStyle" android:layout_width="56dp" android:layout_height="42dp" android:text="▲" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/k_left" style="?android:attr/borderlessButtonStyle" android:layout_width="56dp" android:layout_height="42dp" android:text="◀" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_down" style="?android:attr/borderlessButtonStyle" android:layout_width="56dp" android:layout_height="42dp" android:text="▼" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
            <Button android:id="@+id/k_right" style="?android:attr/borderlessButtonStyle" android:layout_width="56dp" android:layout_height="42dp" android:text="▶" android:textColor="#e0e0e0" android:background="@drawable/kb_key_bg" android:layout_margin="1.5dp" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

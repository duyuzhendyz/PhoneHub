<?xml version="1.0" encoding="utf-8"?>
<!-- 投屏页：手机端界面承载 cs_apps/Screen_mirroring 那套引擎（协议/端口 5423 与参考工程一致）。
     上半部分是参考工程 MainActivity 的控件（IP/端口、清晰度/音质/模式、开始/停止、状态、FPS），
     下半部分保留主工程原有的「电脑画面推到手机」显示区。 -->
<LinearLayout android:orientation="vertical" android:background="#ff1e1e1e" android:padding="12.0dip" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView android:textSize="20.0sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@id/mirrorTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip" android:text="投屏" />

    <!-- 目标电脑 + 连接 -->
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:background="#ff2d2d2d" android:padding="8.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="6.0dip">
        <TextView android:textSize="13.0sp" android:textColor="#ffb0b0b0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="电脑IP" />
        <EditText android:textSize="13.0sp" android:textColor="#ffffffff" android:id="@+id/mirPcIp" android:layout_width="0.0dip" android:layout_height="40.0dip" android:layout_weight="1.0" android:layout_marginStart="4.0dip" android:inputType="text" android:hint="192.168.3.9" android:singleLine="true" />
        <TextView android:textSize="13.0sp" android:textColor="#ffb0b0b0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6.0dip" android:text="端口" />
        <EditText android:textSize="13.0sp" android:textColor="#ffffffff" android:id="@+id/mirPort" android:layout_width="64.0dip" android:layout_height="40.0dip" android:layout_marginStart="4.0dip" android:inputType="number" android:hint="5423" android:singleLine="true" />
        <Button android:textSize="13.0sp" android:id="@+id/mirBtnConnect" android:layout_width="wrap_content" android:layout_height="40.0dip" android:text="连接" />
    </LinearLayout>

    <!-- 清晰度 / 音质 / 模式 -->
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:background="#ff2d2d2d" android:padding="8.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="6.0dip">
        <TextView android:textSize="13.0sp" android:textColor="#ffb0b0b0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="清晰度" />
        <Spinner android:id="@+id/mirQuality" android:layout_width="0.0dip" android:layout_height="40.0dip" android:layout_weight="1.0" android:layout_marginStart="4.0dip" />
        <TextView android:textSize="13.0sp" android:textColor="#ffb0b0b0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6.0dip" android:text="音质" />
        <Spinner android:id="@+id/mirAudio" android:layout_width="0.0dip" android:layout_height="40.0dip" android:layout_weight="1.0" android:layout_marginStart="4.0dip" />
        <TextView android:textSize="13.0sp" android:textColor="#ffb0b0b0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6.0dip" android:text="模式" />
        <Spinner android:id="@+id/mirMode" android:layout_width="0.0dip" android:layout_height="40.0dip" android:layout_weight="1.0" android:layout_marginStart="4.0dip" />
    </LinearLayout>

    <!-- 状态 / FPS -->
    <TextView android:textSize="13.0sp" android:textColor="#ffb0b0b0" android:id="@+id/mirStatus" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="2.0dip" android:text="未开始" />
    <TextView android:textSize="11.0sp" android:textColor="#ff808080" android:id="@+id/mirFps" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="6.0dip" android:text="" />

    <!-- 开始 / 停止 -->
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="4.0dip">
        <Button android:textSize="13.0sp" android:id="@+id/mirBtnStart" android:layout_width="0.0dip" android:layout_height="44.0dip" android:layout_weight="1.0" android:layout_marginEnd="4.0dip" android:text="开始投屏" />
        <Button android:textSize="13.0sp" android:id="@+id/mirBtnStop" android:layout_width="0.0dip" android:layout_height="44.0dip" android:layout_weight="1.0" android:layout_marginStart="4.0dip" android:text="停止投屏" />
    </LinearLayout>

    <!-- 无障碍 / 清除授权 / 断开所有 -->
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
        <Button android:textSize="13.0sp" android:id="@+id/mirBtnAccessibility" android:layout_width="0.0dip" android:layout_height="40.0dip" android:layout_weight="1.0" android:layout_marginEnd="4.0dip" android:text="无障碍设置" />
        <Button android:textSize="13.0sp" android:id="@+id/mirBtnClearCache" android:layout_width="0.0dip" android:layout_height="40.0dip" android:layout_weight="1.0" android:layout_marginStart="4.0dip" android:layout_marginEnd="4.0dip" android:text="清除授权" />
        <Button android:textSize="13.0sp" android:id="@+id/mirBtnDisconnectAll" android:layout_width="0.0dip" android:layout_height="40.0dip" android:layout_weight="1.0" android:layout_marginStart="4.0dip" android:text="断开所有" />
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:id="@id/topButtons" android:background="#ff2d2d2d" android:padding="12.0dip" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dip">
        <!-- 预留容器：原实现留着，暂时不用 -->
    </LinearLayout>

    <!-- 电脑 → 手机 画面（主工程原有能力，保留） -->
    <FrameLayout android:id="@id/mirrorFrame" android:background="#ff000000" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_marginBottom="8.0dip" android:layout_weight="1.0">
        <SurfaceView android:id="@id/mirrorPreview" android:layout_width="fill_parent" android:layout_height="fill_parent" />
        <TextView android:textSize="14.0sp" android:textColor="#ffb0b0b0" android:layout_gravity="center" android:id="@id/mirrorStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未启动" />
        <Button android:textSize="18.0sp" android:textColor="#ffffffff" android:layout_gravity="end|center|top" android:id="@id/btnMirrorFullscreenExit" android:background="#80000000" android:visibility="gone" android:layout_width="44.0dip" android:layout_height="44.0dip" android:layout_margin="8.0dip" android:text="✕" />
    </FrameLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="8.0dip">
        <Button android:id="@id/btnFullscreen" android:layout_width="0.0dip" android:layout_height="44.0dip" android:text="全屏" android:layout_weight="1.0" android:layout_marginEnd="4.0dip" />
        <Button android:id="@id/btnStopPcStream" android:layout_width="0.0dip" android:layout_height="44.0dip" android:text="停止电脑投屏" android:layout_weight="1.0" android:layout_marginStart="4.0dip" />
    </LinearLayout>
</LinearLayout>
